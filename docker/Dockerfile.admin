# syntax=docker/dockerfile:1.7
# SethuCMS admin panel: static files served by an unprivileged nginx.
# Build context: the sethucms-admin repository root, plus this repo's docker/ folder as the named context "infra":
#
#   docker build -f ../sethucms-infra/docker/Dockerfile.admin \
#     --build-context infra=../sethucms-infra/docker \
#     --build-arg VITE_API_URL=https://cms.example.com  ../sethucms-admin

FROM node:25-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
# The API address is baked into the UI at build time. Empty shows sample data.
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Put the API's origin (scheme + host + port) into the content security policy.
FROM alpine:3.20 AS config
ARG VITE_API_URL=
COPY --from=infra nginx.conf security-headers.conf /cfg/
RUN origin="$(printf '%s' "$VITE_API_URL" | sed -E 's|^(https?://[^/]+).*|\1|')"; \
    case "$origin" in http://*|https://*) ;; *) origin="";; esac; \
    sed -i "s|__API_ORIGIN__|$origin|g" /cfg/security-headers.conf

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY --from=config --chown=nginx:nginx /cfg/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=config --chown=nginx:nginx /cfg/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
