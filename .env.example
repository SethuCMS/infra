# Local development only. Copy to .env and fill in with:  sh scripts/generate-local-secrets.sh
# Never commit .env. In staging and production secrets come from a secrets manager, not from files.

# --- control-plane database (the CMS's own metadata) ---
CONTROL_PLANE_DB_PASSWORD=
# --- sample customer databases used for local testing (profile "testdb") ---
TEST_PG_PASSWORD=

# --- application settings (names match docs/10-deployment.md) ---
LOG_LEVEL=info
OIDC_ISSUER=http://localhost:9000/realms/sethucms
OIDC_CLIENT_ID=sethucms-admin
SESSION_SECRET=
# Local stand-in for the KMS key: 32 random bytes, base64. Production uses a real KMS key reference.
KMS_KEY_REF=local:dev
EGRESS_BLOCKLIST_EXTRA=
WORKER_MAX_POOL_PER_CONNECTION=5

# Address the admin UI calls the API on (baked into the UI at build time). Empty shows sample data.
VITE_API_URL=http://localhost:8080
